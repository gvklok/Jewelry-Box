# Copy this file to ".env" (same directory as jewelrybox.py) and fill in real values.
# The .env file is gitignored and must never be committed.

# Telegram bot token from @BotFather
JEWELRYBOX_BOT_TOKEN=your-telegram-bot-token-here

# Numeric Telegram user ID allowed to control the display (get it from @userinfobot)
JEWELRYBOX_CHAT_ID=000000000
